{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workcell.epilogos.dev/schemas/resource-usage-v1.schema.json",
  "title": "Workcell bounded resource usage reading v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ok", "status", "usage_ref", "workcell_ref", "harness_instance_ref", "harness_ref", "material_binding", "interval", "provider", "metrics", "external_correlation_refs"],
  "properties": {
    "schema": { "const": "workcell.resource-usage/v1" },
    "ok": { "const": true },
    "status": { "const": "ok" },
    "usage_ref": { "type": "string", "pattern": "^usage:[0-9a-f]{64}$" },
    "workcell_ref": { "type": "string", "pattern": "^workcell:.+$" },
    "harness_instance_ref": { "type": "string", "pattern": "^instance:.+$" },
    "harness_ref": { "type": "string", "pattern": "^harness/.+$" },
    "material_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "pid", "process_start_marker", "executable", "instance_evidence_grade", "instance_seams"],
      "properties": {
        "kind": { "const": "process" },
        "pid": { "type": "integer", "minimum": 1 },
        "process_start_marker": { "type": "string", "minLength": 1 },
        "executable": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "minLength": 1 }
          }
        },
        "instance_evidence_grade": { "enum": ["live-pid", "gateway-confirmed"] },
        "instance_seams": { "type": "array" }
      }
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "ended_at", "duration_ms", "requested_duration_ms"],
      "properties": {
        "started_at": { "type": "string", "pattern": "^unix-ms:[0-9]+$" },
        "ended_at": { "type": "string", "pattern": "^unix-ms:[0-9]+$" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "requested_duration_ms": { "type": "integer", "minimum": 0, "maximum": 60000 }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_ref", "source", "platform", "collection", "raw_native_refs", "privacy"],
      "properties": {
        "provider_ref": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "collection": { "const": "bounded-on-demand" },
        "raw_native_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "privacy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["argv_collected", "environment_collected"],
          "properties": {
            "argv_collected": { "const": false },
            "environment_collected": { "const": false }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu_time", "cpu_utilisation", "memory_rss", "memory_peak_rss", "gpu_utilisation", "vram", "network_bytes", "storage_io_bytes"],
      "properties": {
        "cpu_time": { "$ref": "#/$defs/metric" },
        "cpu_utilisation": { "$ref": "#/$defs/metric" },
        "memory_rss": { "$ref": "#/$defs/metric" },
        "memory_peak_rss": { "$ref": "#/$defs/metric" },
        "gpu_utilisation": { "$ref": "#/$defs/metric" },
        "vram": { "$ref": "#/$defs/metric" },
        "network_bytes": { "$ref": "#/$defs/metric" },
        "storage_io_bytes": { "$ref": "#/$defs/metric" }
      }
    },
    "external_correlation_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "metric": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["standing", "value", "unit", "evidence"],
          "properties": {
            "standing": { "enum": ["observed", "provider-reported", "sampled"] },
            "value": { "type": "number" },
            "unit": { "type": "string", "minLength": 1 },
            "evidence": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["standing", "value", "unit", "derivation"],
          "properties": {
            "standing": { "const": "derived" },
            "value": { "type": "number" },
            "unit": { "type": "string", "minLength": 1 },
            "derivation": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["standing", "reason"],
          "properties": {
            "standing": { "enum": ["unavailable", "unsupported"] },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
